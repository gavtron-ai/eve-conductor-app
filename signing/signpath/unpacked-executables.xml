<!-- SignPath artifact configuration "unpacked-executables" (pass 1 of .github/workflows/windows-build.yml):
     one ZIP holding the app's executables from release/win-unpacked — the app exe and Electron's DLLs —
     every one of them Authenticode-signed. Paste into the project's artifact configuration in SignPath. -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file-set>
      <include path="*.exe" />
      <include path="*.dll" />
      <for-each>
        <authenticode-sign/>
      </for-each>
    </pe-file-set>
  </zip-file>
</artifact-configuration>
